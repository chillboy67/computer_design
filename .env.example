# 复制本文件为 .env 并填写，.env 不会被提交到仓库

# 智谱 AI 开放平台的 API Key：https://open.bigmodel.cn/
ZHIPUAI_API_KEY=

# 使用的模型，默认 glm-4-plus
LLM_MODEL=glm-4-plus

# 单次 AI 请求的超时时间（秒）
LLM_TIMEOUT=60

# 数据库连接，留空则使用项目目录下的 health_db.sqlite
# DATABASE_URL=sqlite:///health_db.sqlite

# 首次启动时自动创建的演示账号，密码留空则不创建
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
