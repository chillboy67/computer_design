# 复制本文件为 .env 并填写，.env 不会被提交到仓库

# ---------------- 大模型服务 ----------------
# 默认使用智谱 AI（https://open.bigmodel.cn/），只需填写 LLM_API_KEY。
# 也可以换成其他兼容 OpenAI 接口格式的服务，同时填写 LLM_BASE_URL 和 LLM_MODEL 即可，例如：
#   DeepSeek:  LLM_BASE_URL=https://api.deepseek.com                            LLM_MODEL=deepseek-chat
#   通义千问:  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
#   Kimi:      LLM_BASE_URL=https://api.moonshot.cn/v1                          LLM_MODEL=moonshot-v1-8k
# 接口地址和模型名称以各服务商的文档为准。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=glm-4-plus

# 单次 AI 请求的超时时间（秒）
LLM_TIMEOUT=60

# ---------------- 其他 ----------------
# 数据库连接，留空则使用程序目录下的 health_db.sqlite
# DATABASE_URL=sqlite:///health_db.sqlite

# 首次启动时自动创建的演示账号，密码留空则不创建
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
